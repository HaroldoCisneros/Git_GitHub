; Copie este archivo como config.ini y ajuste los valores.

[sql]
; Servidor SQL Server (si está en un contenedor Docker en este mismo equipo: localhost)
servidor = localhost
puerto = 1433
base_datos = VALPA_A
usuario = profit
clave = profit
timeout = 5

[tabla]
; Tabla y columnas de donde se leen los artículos
nombre = art
codigo = co_art
descripcion = art_des
precio = prec_vta1
; Columna que va en el código de barras (puede ser la misma del código)
barras = co_art

[impresora]
; tipo: red | windows | dispositivo | archivo
;   red         -> destino = IP de la Zebra (puerto 9100)
;   windows     -> destino = nombre de la impresora instalada en Windows (requiere pywin32)
;   dispositivo -> destino = /dev/usb/lp0  o  \\PC-CAJA\Zebra
;   archivo     -> destino = etiquetas.zpl (para pruebas)
tipo = red
destino = 192.168.1.50
puerto = 9100
dpi = 203

[etiqueta]
formato = 3 x 2,2 cm vertical
moneda = Bs.
