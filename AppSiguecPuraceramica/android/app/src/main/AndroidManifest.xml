<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================
     AndroidManifest.xml
     "Carta de presentación" de la app para Android: nombre, ícono,
     permisos y cuál pantalla se abre primero.
     ================================================================ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso de red: la App se conecta directo al SQL Server por el WiFi de la empresa -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SiguecApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppSiguecPuraceramica">
        <!-- name: clase que arranca primero (crea la sesión)                     -->
        <!-- allowBackup=false: los datos de conexión (clave de SQL) y los conteos  -->
        <!--   guardados en el teléfono NO se copian a la nube                     -->

        <!-- Escáner de códigos de Google: que Play Services lo descargue al instalar la App
             (si no, se descarga la primera vez que se toca "Escanear" y tarda un poco) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- La única Activity; las pantallas van dentro con Compose -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- adjustResize: la pantalla se ajusta cuando sale el teclado -->

            <!-- Esta Activity es la que abre el ícono de la app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
