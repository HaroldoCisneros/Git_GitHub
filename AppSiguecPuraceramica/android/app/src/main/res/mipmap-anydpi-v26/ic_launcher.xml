    <!-- Fondo blanco, como el del logo -->
    <background android:drawable="@color/fondo_icono" />
    <!-- Símbolo del logo de Puracerámica (drawable-nodpi/ic_launcher_foreground.png) -->
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
