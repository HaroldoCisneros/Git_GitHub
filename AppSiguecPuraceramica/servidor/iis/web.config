<?xml version="1.0" encoding="utf-8"?>
<!-- ====================================================================
     web.config del sitio de IIS que publica AppSiguecPuraceramica por HTTPS.

     IIS NO ejecuta la API: solo recibe a los teléfonos por el puerto 443
     (con el certificado de win-acme) y les pasa cada petición a la API,
     que escucha en el mismo equipo en http://127.0.0.1:8000.

     Requiere: URL Rewrite + Application Request Routing (ARR) con
     "Enable proxy" activado (ver README.md, "Opción 2: IIS").
     ==================================================================== -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Todo lo que llegue por http:// se manda a https:// (la clave no viaja sin cifrar) -->
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Pasar la petición a la API.
             {UNENCODED_URL} = la dirección tal como la mandó el teléfono: así un
             código como "COD/002" (que viaja como COD%2F002) llega intacto. -->
        <rule name="AppSiguecPuraceramica API" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:8000{UNENCODED_URL}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Los errores (401, 409, 422...) los arma la API en JSON: IIS no los reemplaza -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
