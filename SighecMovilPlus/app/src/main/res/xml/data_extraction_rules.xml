<?xml version="1.0" encoding="utf-8"?>
<!-- Los datos del negocio viven sólo en el teléfono: no se respaldan en la nube ni se transfieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
